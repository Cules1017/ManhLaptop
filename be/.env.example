# VNPay (sandbox/test)
VNPAY_TMN_CODE=9XWJR31W
VNPAY_HASH_SECRET=BKCAACE8TVX97L1FE5CC9784YC8B595X
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/api/vnpay/return
VNPAY_FRONTEND_RETURN_URL=http://localhost:3001/vnpay-return
VNPAY_NOTIFY_URL=http://127.0.0.1:8000/api/vnpay/notify
# If VNPay keys are missing, backend sẽ tự fallback sang mock mode.
VNPAY_MOCK=false
#
# Optional: force VNPay sandbox to show a specific payment method/bank.
# Example (depends on VNPay docs): VNPAY_BANK_CODE=VNPAYQR
VNPAY_BANK_CODE=VNPAYQR

# Expire time for VNPay transaction (minutes).
# Increase during testing to avoid "too late to pay".
VNPAY_EXPIRE_MINUTES=30

